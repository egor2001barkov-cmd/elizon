# Telegram bot for contact form notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email notifications (SMTP) — все формы → support@elizon.ru
CONTACT_EMAIL=support@elizon.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=support@elizon.ru
SMTP_PASS=your_app_password_here
SMTP_FROM="ELIZON <support@elizon.ru>"

# Public site URL (for payment return links)
NEXT_PUBLIC_SITE_URL=https://elizon.ru

# Comma-separated extra origins allowed to POST /api/contact (optional)
# ALLOWED_ORIGINS=https://elizon.ru

# Analytics — default counter 111042033 in code; override if needed
NEXT_PUBLIC_YANDEX_METRIKA_ID=111042033
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Admin (/admin) — optional overrides; password is stored as scrypt hash in code, not plain text
# ADMIN_EMAIL=support@elizon.ru
# ADMIN_SESSION_SECRET=long-random-string
# ADMIN_PASSWORD_HASH=base64-scrypt-hash

# Реквизиты на сайте (trust)
# NEXT_PUBLIC_COMPANY_INN=770000000000
# NEXT_PUBLIC_COMPANY_OGRNIP=300000000000000
# Карточка организации Яндекс.Бизнес (не поиск по адресу)
# NEXT_PUBLIC_YANDEX_BUSINESS_URL=https://yandex.ru/maps/org/...