# Образ из ПРЕДСОБРАННОГО standalone-бандла (сборка делается на Mac, не на VPS).
# Положить рядом с папкой app/ (standalone + static + public + data) и собрать:
#   docker build -t elizon-web:latest -f Dockerfile.prebuilt .
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nodejs && adduser -S nextjs
COPY --chown=nextjs:nodejs app ./
RUN mkdir -p /app/data && chown -R nextjs:nodejs /app/data
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
